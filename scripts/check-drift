#!/bin/sh
# Report drift between this repo's tracked dotfiles and the live copies under
# $HOME that install.sh deploys to. Mirrors install.sh's path list — keep in
# sync if install.sh changes.
#
# Expected drift (do not "fix"):
#   - config/zsh/.zshrc: deployed has a hiive init block re-injected on every
#     interactive shell by the Hiive CLI.
#   - config/nvim: lazyvim.json and similar runtime files exist only in deployed.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

check_file() {
    src="$1"; dest="$2"
    if [ ! -e "$dest" ]; then
        printf 'MISSING  %s\n' "$dest"
    elif ! cmp -s "$src" "$dest"; then
        printf 'DIFFERS  %s  (vs %s)\n' "$dest" "$src"
    fi
}

check_dir() {
    src="$1"; dest="$2"
    if [ ! -d "$dest" ]; then
        printf 'MISSING  %s\n' "$dest"
        return
    fi
    diff -r --brief "$src" "$dest" 2>&1 | sed 's/^/  /'
}

echo "== files =="
check_file dotfiles/gitconfig          "$HOME/.gitconfig"
check_file dotfiles/gitignore          "$HOME/.gitignore"
check_file dotfiles/hushlogin          "$HOME/.hushlogin"
check_file dotfiles/psqlrc             "$HOME/.psqlrc"
check_file dotfiles/zshenv             "$HOME/.zshenv"
check_file bin/wt                      "$HOME/.local/bin/wt"
check_file config/claude/CLAUDE.md     "$HOME/.claude/CLAUDE.md"
check_file config/claude/settings.json "$HOME/.claude/settings.json"

echo
echo "== directories =="
for pair in \
    "config/atuin:$HOME/.config/atuin" \
    "config/ghostty:$HOME/.config/ghostty" \
    "config/nvim:$HOME/.config/nvim" \
    "config/psql:$HOME/.config/psql" \
    "config/zellij:$HOME/.config/zellij" \
    "config/zsh:$HOME/.config/zsh" \
    "config/zsh-patina:$HOME/.config/zsh-patina" \
    "config/claude/skills:$HOME/.claude/skills"
do
    src="${pair%%:*}"
    dest="${pair#*:}"
    echo "-- $src --"
    check_dir "$src" "$dest"
done
